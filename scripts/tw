#!/usr/bin/env bash
set -euo pipefail
IMAGE=tickwire-dev:gcc10-cmake3.28.4-x11
docker image inspect "$IMAGE" >/dev/null 2>&1 || docker build -t "$IMAGE" "$(dirname "$0")/.."
# Without these caps, TSan aborts with "unexpected memory mapping"; without
# --user, the bind mount writes root-owned files onto the host. setarch -R
# alone is not sufficient - it still fails with "Operation not permitted"
# unless the container is also granted these capabilities.
X11_ARGS=()
if [[ -e /tmp/.X11-unix && -n "${DISPLAY:-}" ]]; then
  X11_ARGS=(-e DISPLAY="$DISPLAY" -v /tmp/.X11-unix:/tmp/.X11-unix)
fi
exec docker run --rm \
  --cap-add SYS_PTRACE --security-opt seccomp=unconfined \
  --user "$(id -u):$(id -g)" \
  -v "$PWD":/work -w /work \
  "${X11_ARGS[@]}" \
  "$IMAGE" "$@"
